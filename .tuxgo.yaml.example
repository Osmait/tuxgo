# Local TuxGo Configuration
# Place this file as .tuxgo.yaml in your project root
# This configuration takes priority over global config

windows:
  - name: editor
    command: "nvim ."
  - name: server
    layout: horizontal
    panels:
      - command: "go run ."
      - command: "tail -f logs/app.log"
  - name: opencode
    command: "opencode"
